[Unit]
Description=edit.r (painel mobile do Claude Code)
# Sem limite de partidas: com o RestartSec curto, um laço de quedas pararia o serviço em 10 s.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Projects/editr/server
# Via zsh interativo para herdar o ambiente do ~/.zshrc (PATH, JAVA_HOME, ANDROID_HOME…):
# as sessões abertas pelo celular precisam enxergar as mesmas ferramentas do terminal.
ExecStart=/usr/bin/zsh -lic 'exec /usr/bin/node src/index.ts'
SyslogIdentifier=editr
Restart=on-failure
RestartSec=1
# SIGTERM só no processo principal, que encerra as sessões do painel com calma;
# o que sobrar recebe SIGKILL ao fim do timeout.
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
